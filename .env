# StarCloud Panel
PORT=8080
STARCLOUD_DATA_DIR=./data
PANEL_NAME=StarCloud
DEFAULT_LOGO_URL=/images/logo.png

# Security: set a 32+ character random value in production.
# If empty, StarCloud generates one and stores it in data/session_secret (0600).
SESSION_SECRET=
# true only when served over HTTPS
COOKIE_SECURE=false
