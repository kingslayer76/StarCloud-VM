# ---- StarCloud Panel: copy this file to .env and fill in real values ----
# Server
PORT=8080
NODE_ENV=production
STARCLOUD_DATA_DIR=./data
PANEL_NAME=StarCloud
PANEL_VERSION=V2.0
DEFAULT_LOGO_URL=/images/logo.png

# Security (REQUIRED in production): at least 32 random characters.
# If left empty, StarCloud generates one and stores it in data/session_secret (mode 0600).
SESSION_SECRET=
# Set to true only when the panel is served over HTTPS (reverse proxy / TLS).
COOKIE_SECURE=false

# Discord OAuth (optional; can also be configured from Admin -> Settings)
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# DISCORD_REDIRECT_URI=

# AI assistant (optional, default OFF)
# GEMINI_API_KEY=
