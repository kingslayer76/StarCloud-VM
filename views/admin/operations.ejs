<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    .ops-grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap:16px; }
    .ops-banner { padding:12px 14px; border-radius:8px; font-size:13px; margin-bottom:10px; }
    .ops-banner.bad { background:rgba(239,68,68,.12); border:1px solid rgba(239,68,68,.4); }
    .ops-banner.good { background:rgba(34,197,94,.12); border:1px solid rgba(34,197,94,.4); }
    .ops-banner.warn { background:rgba(234,179,8,.12); border:1px solid rgba(234,179,8,.4); }
    .ops-kv { display:flex; justify-content:space-between; font-size:13px; padding:6px 0; border-bottom:1px solid var(--border-subtle); }
    .ops-hint { font-size:12px; color: var(--text-muted); margin-top:6px; }
    .ops-table { width:100%; border-collapse:collapse; font-size:12px; }
    .ops-table th, .ops-table td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--border-subtle); vertical-align:top; }
    .ops-msg { margin-top:10px; font-size:13px; }
  </style>
</head>
<body>
<div class="admin-wrapper">
  <%- include('../partials/admin/sidebar') %>

  <div class="admin-main">
    <%- include('../partials/admin/header') %>

    <div class="admin-content">
      <div class="page-header">
        <div class="page-title-section">
          <h1 class="page-title">Operations</h1>
          <p class="page-subtitle">Host health, maintenance mode, emergency controls and the audit log (who did what, when).</p>
        </div>
      </div>

      <div class="ops-grid">
        <!-- Host capability report -->
        <div class="card">
          <div class="card-header"><h3 class="card-title">Host virtualization (KVM)</h3></div>
          <div id="capBox">Checking host…</div>
          <div class="ops-hint">KVM = Kernel-based Virtual Machine, the hardware acceleration that makes VMs fast. Without it, VMs run in slow software emulation.</div>
        </div>

        <!-- Maintenance -->
        <div class="card">
          <div class="card-header"><h3 class="card-title">Maintenance mode</h3></div>
          <div class="ops-hint" style="margin-bottom:10px;">When ON, customers and visitors see a maintenance notice. Admins keep full access.</div>
          <label style="display:flex; gap:10px; align-items:center; margin-bottom:10px;">
            <input type="checkbox" id="mtEnabled"> <strong>Maintenance mode is ON</strong>
          </label>
          <label class="form-label" for="mtMessage">Message shown to visitors</label>
          <textarea id="mtMessage" class="input" rows="3" maxlength="300" placeholder="We are upgrading the host. Back shortly."></textarea>
          <div style="margin-top:10px;"><button class="btn btn-primary" id="mtSave">Save maintenance setting</button></div>
          <div class="ops-msg" id="mtMsg"></div>
        </div>

        <!-- Emergency -->
        <div class="card">
          <div class="card-header"><h3 class="card-title">Emergency controls</h3></div>
          <div class="ops-hint" style="margin-bottom:10px;">Use only when the host is in danger (overload, abuse, a bad kernel update). Each action needs you to type the exact words shown.</div>
          <div style="display:grid; gap:12px;">
            <div>
              <button class="btn btn-danger" id="emStop">Stop ALL running VMs</button>
              <div class="ops-hint">Type <strong>STOP ALL</strong> to confirm.</div>
            </div>
            <div>
              <button class="btn btn-outline" id="emReboot">Reboot ALL running VMs</button>
              <div class="ops-hint">Type <strong>REBOOT ALL</strong> to confirm. Stops then starts every VM that was running.</div>
            </div>
          </div>
          <div class="ops-msg" id="emMsg"></div>
        </div>
      </div>

      <!-- Audit -->
      <div class="card" style="margin-top:16px;">
        <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
          <h3 class="card-title">Audit log (latest 200)</h3>
          <div style="display:flex; gap:8px;">
            <button class="btn btn-ghost btn-sm" id="auditRefresh">Refresh</button>
            <a class="btn btn-outline btn-sm" href="/api/admin/audit.csv?limit=5000">Download CSV</a>
          </div>
        </div>
        <div style="overflow-x:auto;">
          <table class="ops-table">
            <thead><tr><th>Time</th><th>Who</th><th>Action</th><th>Target</th><th>Result</th><th>IP</th><th>Details</th></tr></thead>
            <tbody id="auditRows"><tr><td colspan="7">Loading…</td></tr></tbody>
          </table>
        </div>
      </div>
    </div>
    <%- include('../partials/admin/footer') %>
  </div>
</div>

<script>
const $ = (id) => document.getElementById(id);
function esc(s) { return String(s === null || s === undefined ? '' : s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
async function api(method, url, body) {
  const opts = { method, credentials: 'same-origin', headers: {} };
  if (body !== undefined) { opts.headers['Content-Type'] = 'application/json'; opts.body = JSON.stringify(body); }
  const res = await fetch(url, opts);
  const data = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(data.error || ('Request failed (' + res.status + ')'));
  return data;
}

async function loadStatus() {
  try {
    const d = await api('GET', '/api/admin/operations');
    const c = d.capabilities;
    let html = '';
    if (c.kvmAvailable) {
      html += '<div class="ops-banner good"><strong>KVM is available.</strong> VMs can use hardware acceleration.</div>';
    } else {
      html += '<div class="ops-banner bad"><strong>KVM is NOT available on this host.</strong> The "KVM On / Off" option is locked OFF and nested KVM is unavailable. VMs use slow software emulation.</div>';
    }
    if (c.reasons && c.reasons.length) {
      html += '<ul style="font-size:12px; margin:6px 0 10px 18px;">' + c.reasons.map(r => '<li>' + esc(r) + '</li>').join('') + '</ul>';
    }
    html += `<div class="ops-kv"><span>CPU vendor</span><span>${esc(c.cpuVendor)}</span></div>`;
    html += `<div class="ops-kv"><span>Hardware virtualization flag</span><span>${esc(c.virtFlag || 'none')}</span></div>`;
    html += `<div class="ops-kv"><span>/dev/kvm usable</span><span>${c.devKvmWritable ? 'yes' : 'no'}</span></div>`;
    html += `<div class="ops-kv"><span>Host nested KVM module</span><span>${c.hostNestedOn ? 'on' : 'off'}</span></div>`;
    html += `<div class="ops-kv"><span>VMs (total / running)</span><span>${d.vms.total} / ${d.vms.running}</span></div>`;
    $('capBox').innerHTML = html;
    $('mtEnabled').checked = !!d.maintenance.enabled;
    if (document.activeElement !== $('mtMessage')) $('mtMessage').value = d.maintenance.message || '';
  } catch (e) { $('capBox').textContent = 'Could not load: ' + e.message; }
}

$('mtSave').onclick = async () => {
  try {
    await api('PUT', '/api/admin/maintenance', { enabled: $('mtEnabled').checked, message: $('mtMessage').value });
    $('mtMsg').textContent = 'Saved. Maintenance is ' + ($('mtEnabled').checked ? 'ON' : 'OFF') + '.';
    $('mtMsg').style.color = '#86efac';
    loadAudit();
  } catch (e) { $('mtMsg').textContent = e.message; $('mtMsg').style.color = '#fca5a5'; }
};

async function emergency(word, url, label, button) {
  const typed = prompt(label + '\n\nType ' + word + ' (exact words) to confirm:');
  if (typed === null) return;
  button.disabled = true;
  $('emMsg').style.color = '';
  $('emMsg').textContent = 'Working… please wait.';
  try {
    const d = await api('POST', url, { confirm: typed });
    $('emMsg').style.color = '#86efac';
    $('emMsg').textContent = 'Done. VMs affected: ' + d.count + (d.results ? ' (' + d.results.filter(r => r.started === false).length + ' failed to start)' : '');
  } catch (e) { $('emMsg').style.color = '#fca5a5'; $('emMsg').textContent = e.message; }
  button.disabled = false;
  loadStatus(); loadAudit();
}
$('emStop').onclick = () => emergency('STOP ALL', '/api/admin/emergency/stop-all', 'Stop every running VM now?', $('emStop'));
$('emReboot').onclick = () => emergency('REBOOT ALL', '/api/admin/emergency/reboot-all', 'Reboot every running VM now?', $('emReboot'));

async function loadAudit() {
  try {
    const rows = await api('GET', '/api/admin/audit?limit=200');
    if (!rows.length) { $('auditRows').innerHTML = '<tr><td colspan="7">No entries yet.</td></tr>'; return; }
    $('auditRows').innerHTML = rows.map(r => `<tr>
      <td>${esc(r.created_at)}</td><td>${esc(r.actor_name || 'system')}</td><td>${esc(r.action)}</td>
      <td>${esc(r.target)}</td><td>${esc(r.result)}</td><td>${esc(r.ip)}</td><td>${esc(r.details)}</td></tr>`).join('');
  } catch (e) { $('auditRows').innerHTML = '<tr><td colspan="7">' + esc(e.message) + '</td></tr>'; }
}
$('auditRefresh').onclick = loadAudit;

loadStatus();
loadAudit();
</script>
</body>
</html>
