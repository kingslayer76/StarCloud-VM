              <img id="previewIcon" src="" style="width: 48px; height: 48px; margin-bottom: 10px; border-radius: 8px; object-fit: cover; display: none;" onerror="this.style.display='none'; document.getElementById('previewIconFallback').style.display='block';">
              <div style="font-size: 36px; margin-bottom: 10px; display: none; color: var(--accent-primary);" id="previewIconFallback">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
              </div>
              <div style="font-size: 16px; font-weight: 700;" id="previewTitle">StarCloud Panel</div>
              <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;" id="previewDesc">Virtual Machine Management System</div>
            </div>
          </div>
        </div>
      </div>

      <!-- SECURITY TAB -->
      <div class="tab-pane" id="tab-security">
        <div class="settings-section">
          <div class="settings-section-header">
            <span class="settings-section-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg></span>
            <div><div class="settings-section-title">Security Settings</div></div>
          </div>
          <div class="settings-section-body">
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Change Admin Password</div><div class="settings-row-desc">Update administrator credentials</div></div>
              <div class="settings-row-control"><button class="btn btn-outline btn-sm" onclick="openModal('changePasswordModal')" style="display: flex; align-items: center; gap: 6px;"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2l-2 2m-7.6 7.6a5.5 5.5 0 1 0-7.8 7.8 5.5 5.5 0 0 0 7.8-7.8z"/><path d="M15 5l4 4"/></svg> Change Password</button></div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Public Sign-up</div><div class="settings-row-desc">Let new users create an account with username and password (or Discord) from /signup</div></div>
              <div class="settings-row-control">
                <select class="form-control" id="setting_signup_enabled" data-key="signup_enabled" style="max-width: 160px;">
                  <option value="1" selected>On (allow sign-up)</option>
                  <option value="0">Off (admin creates accounts)</option>
                </select>
              </div>
            </div>
            <div class="settings-row">
              <div class="settings-row-info"><div class="settings-row-label">Active Sessions</div><div class="settings-row-desc">View and manage logins</div></div>
              <div class="settings-row-control"><div style="font-size: 13px; color: var(--text-secondary);"><span class="badge-dot"></span>Managed by server</div></div>
            </div>
          </div>
        </div>
        <!-- Security overview with SVG icons -->
        <div class="card">
          <div class="card-header">
            <div class="card-title"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Security Overview</div>
          </div>
          <div class="card-body">
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px;">
              <div style="padding: 14px; background: rgba(16, 185, 129, 0.06); border: 1px solid rgba(16, 185, 129, 0.15); border-radius: 8px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--accent-green);"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="M9 12l2 2 4-4"/></svg>
                <div style="font-size: 12px; font-weight: 600; color: var(--accent-green); margin-top: 6px;">Session Auth</div>
                <div style="font-size: 11px; color: var(--text-muted);">bcrypt hashed</div>
              </div>
              <div style="padding: 14px; background: rgba(99, 102, 241, 0.06); border: 1px solid rgba(99, 102, 241, 0.15); border-radius: 8px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--accent-primary);"><path d="M21 2l-2 2m-7.6 7.6a5.5 5.5 0 1 0-7.8 7.8 5.5 5.5 0 0 0 7.8-7.8z"/><path d="M15 5l4 4"/></svg>
                <div style="font-size: 12px; font-weight: 600; color: var(--accent-primary); margin-top: 6px;">RBAC Control</div>
                <div style="font-size: 11px; color: var(--text-muted);">Admin/User roles</div>
              </div>
              <div style="padding: 14px; background: rgba(245, 158, 11, 0.06); border: 1px solid rgba(245, 158, 11, 0.15); border-radius: 8px;">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" style="color: var(--accent-orange);"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/></svg>
                <div style="font-size: 12px; font-weight: 600; color: var(--accent-orange); margin-top: 6px;">VM Isolation</div>
                <div style="font-size: 11px; color: var(--text-muted);">Only own VMs</div>
