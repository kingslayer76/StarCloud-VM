<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <meta name="theme-color" content="#0a0a0f">
  <title><%= title || 'Login - StarCloud Panel' %></title>
  <link rel="icon" href="<%= siteLogo %>" type="image/png">
  <link rel="stylesheet" href="/css/admin.css">
  <style>
    html, body {
      height: auto;
      min-height: 100vh;
    }

    .login-form-icon-toggle {
      position: absolute;
      right: 12px; top: 50%;
      transform: translateY(-50%);
      background: none; border: none;
      color: var(--text-muted); cursor: pointer;
      padding: 4px; font-size: 16px;
      transition: color 0.15s;
    }
    .login-form-icon-toggle:hover { color: var(--text-primary); }
    .pw-wrapper { position: relative; }
    .pw-wrapper .form-control { padding-right: 40px; }
    
    @keyframes loginFloat {
      0%, 100% { transform: translateY(0) rotate(0deg); opacity: 0.4; }
      50% { transform: translateY(-15px) rotate(3deg); opacity: 0.8; }
    }
    
    .login-float-icon {
      position: absolute;
      font-size: 24px;
      animation: loginFloat ease-in-out infinite;
      pointer-events: none;
    }
    
    .shake {
      animation: shake 0.4s ease;
    }
    
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      25% { transform: translateX(-8px); }
      75% { transform: translateX(8px); }
    }

    /* Logo inside card */
    .login-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--border-color);
    }

    .login-welcome { margin-top: 10px; font-size: 13px; line-height: 1.5; color: var(--text-secondary, #cbd5e1); }
    .login-welcome span { font-size: 11px; color: var(--text-muted, #94a3b8); }
    .login-logo-inside {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
    }

    .login-logo-icon {
      width: 64px;
      height: 64px;
      background: transparent;
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 48px;
      animation: float 3.5s ease-in-out infinite;
    }

    /* Mobile Responsive */
    @media (max-width: 768px) {
      .login-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
      }

      .login-container {
        max-width: 100%;
        width: 100%;
        padding: 20px;
      }

      .login-card-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
        flex-wrap: wrap;
      }

      .login-logo-inside {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
      }

      .login-logo-icon {
        width: 56px;
        height: 56px;
        font-size: 36px;
        margin: 0;
      }

      .login-logo-title {
        font-size: 20px;
      }

      .login-logo-sub {
        font-size: 12px;
      }

      .login-card {
        padding: 24px 20px;
        border-radius: 16px;
      }

      .login-title {
        font-size: 16px;
        margin-bottom: 6px;
      }

      .login-subtitle {
        font-size: 12px;
        margin-bottom: 20px;
      }

      .form-label {
        font-size: 11px;
      }

      .form-control {
        font-size: 14px;
        padding: 10px 12px;
      }

      .btn-lg {
        padding: 11px 20px;
        font-size: 13px;
      }

      .login-footer {
        font-size: 11px;
        margin-top: 20px;
      }
    }

    @media (max-width: 480px) {
      .login-page {
        padding: 12px;
      }

      .login-container {
        padding: 16px;
      }

      .login-card-header {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }

      .login-logo-icon {
        width: 48px;
        height: 48px;
        font-size: 32px;
        margin: 0;
      }

      .login-logo-title {
        font-size: 18px;
      }

      .login-card {
        padding: 20px 16px;
        border-radius: 14px;
      }

      .login-title {
        font-size: 15px;
      }

      .login-subtitle {
        font-size: 11px;
      }

      .form-group {
        margin-bottom: 14px;
      }

      .form-label {
        font-size: 10px;
        margin-bottom: 6px;
      }

      .form-control {
        font-size: 16px; /* Prevents zoom on iOS */
        padding: 10px 12px;
      }

      .login-form-icon-toggle {
        right: 10px;
        font-size: 14px;
      }

      .btn-lg {
        padding: 10px 18px;
        font-size: 13px;
        gap: 5px;
      }

      .login-footer {
        font-size: 10px;
        margin-top: 16px;
      }

      /* Hide floating icons on small screens */
      .login-float-icon {
        display: none;
      }
    }
  </style>
</head>
<body>

<!-- Animated Background -->
<div class="login-bg"></div>
<div class="login-bg-grid"></div>

<!-- Floating Decorative Icons -->
<span class="login-float-icon" style="top:10%; left:8%; animation-duration:4s; animation-delay:0s;">💻</span>
<span class="login-float-icon" style="top:20%; right:10%; animation-duration:5s; animation-delay:1s;">🖥️</span>
<span class="login-float-icon" style="bottom:15%; left:12%; animation-duration:6s; animation-delay:2s;">⚡</span>
<span class="login-float-icon" style="bottom:25%; right:8%; animation-duration:4.5s; animation-delay:0.5s;">🔐</span>
<span class="login-float-icon" style="top:50%; left:3%; animation-duration:7s; animation-delay:1.5s;">🌐</span>

<div class="login-page">
  <div class="login-container">

    <!-- Signup Card -->
    <div class="login-card" id="signupCard">
      <div class="login-card-header">
        <div>
          <div class="login-title">Create Account</div>
          <div class="login-subtitle">Sign up to start managing your virtual machines</div>
          <div class="login-welcome">Welcome to StarCloud Panel. Manage your virtual machines in one place.<br><span>Made by KingSlayer · Inspired by HopingBoyz</span></div>
        </div>
        <div class="login-logo-inside">
          <div class="login-logo-icon" style="display: flex; align-items: center; justify-content: center;">
            <img src="<%= siteLogo %>" style="width: 48px; height: 48px; object-fit: contain; border-radius: 8px;" alt="StarCloud Panel Logo">
          </div>
        </div>
      </div>

      <div id="signupAlert" style="display:none; margin-bottom: 16px;"></div>

      <% if (!signupOpen) { %>
        <div class="alert alert-warning" style="display:flex;"><span class="alert-icon">⚠️</span><span>New sign-ups are currently closed. Please contact the administrator or ask for an account on Discord.</span></div>
      <% } else { %>
      <form id="signupForm" onsubmit="handleSignup(event)" autocomplete="on">

        <div class="form-group">
          <label class="form-label" for="signupUsername">Username</label>
          <input type="text" id="signupUsername" name="username" class="form-control" placeholder="3–32 characters: letters, numbers, _ . -" autocomplete="username" minlength="3" maxlength="32" pattern="[a-zA-Z0-9_.\-]{3,32}" required autofocus>
        </div>

        <div class="form-group">
          <label class="form-label" for="signupEmail">Email <span style="opacity:.6; font-size: 11px;">(optional)</span></label>
          <input type="email" id="signupEmail" name="email" class="form-control" placeholder="you@example.com" autocomplete="email" maxlength="120">
        </div>

        <div class="form-group">
          <label class="form-label" for="signupPassword">Password</label>
          <div class="pw-wrapper">
            <input type="password" id="signupPassword" name="password" class="form-control" placeholder="At least 6 characters" autocomplete="new-password" minlength="6" maxlength="200" required>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="signupPassword2">Confirm password</label>
          <div class="pw-wrapper">
            <input type="password" id="signupPassword2" name="password2" class="form-control" placeholder="Re-enter password" autocomplete="new-password" minlength="6" maxlength="200" required>
            <button type="button" class="login-form-icon-toggle" onclick="toggleSignupPassword()" id="pwToggle" aria-label="Show or hide password">👁️</button>
          </div>
        </div>

        <button type="submit" class="btn btn-primary w-100 btn-lg" id="signupBtn">Create Account</button>

      </form>
      <% } %>

      <div style="text-align:center; margin-top: 16px; font-size: 13px;">
        Already have an account? <a href="/login" style="color: var(--accent-cyan, #22d3ee);">Sign in</a>
      </div>

      <% if (signupOpen) { %>
      <div style="display: flex; align-items: center; gap: 12px; margin: 20px 0; opacity: 0.6;">
        <div style="flex: 1; height: 1px; background: var(--border-color);"></div>
        <span style="font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Or sign up with</span>
        <div style="flex: 1; height: 1px; background: var(--border-color);"></div>
      </div>
      <% } %>

      <!-- Discord Signup Button (shown only when Discord login is enabled in Settings > Discord) -->
      <button type="button" class="btn w-100 btn-lg" id="discordLoginBtn" onclick="loginWithDiscord()" style="background: #5865F2; color: white; border: none; display: none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.317 4.3632a19.791 19.791 0 00-4.885-1.515a.074.074 0 00-.079.0366c-.211.3648-.444.8384-.607 1.2144a18.27 18.27 0 00-5.487 0c-.163-.3776-.385-.8496-.607-1.2144a.077.077 0 00-.079-.0366 19.736 19.736 0 00-4.885 1.515.07.07 0 00-.032.0277C.533 9.0458-.319 13.5799.099 18.0578a.082.082 0 00.031.0557 19.9 19.9 0 005.993 3.0294.078.078 0 00.084-.0276c.461-.6298.873-1.2952 1.226-1.9942a.076.076 0 00-.041-.1057 13.107 13.107 0 01-1.872-.8922.077.077 0 01-.008-.1277c.125-.0939.251-.1918.371-.2902a.074.074 0 01.077-.0104c3.928 1.7933 8.18 1.7933 12.061 0a.074.074 0 01.078.0096c.12.0984.246.1963.371.2902a.077.077 0 01-.006.1277 12.299 12.299 0 01-1.873.8912.076.076 0 00-.041.1067c.36.698.772 1.3634 1.225 1.9932a.076.076 0 00.084.0286 19.839 19.839 0 006.002-3.0294.077.077 0 00.032-.0547c.5-5.1767-.8358-9.6786-3.5497-13.6614a.061.061 0 00-.031-.03zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.157 2.419 0 1.3332-.9555 2.4189-2.157 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.157 2.419 0 1.3332-.946 2.4189-2.1569 2.4189Z"/>
        </svg>
        Sign up with Discord
      </button>

    <div class="login-footer">
      <%= siteName %> · &copy; <%= new Date().getFullYear() %> KingSlayer
      <br>
      <span style="font-size: 10px; color: var(--text-muted);">Powered by QEMU/KVM + Express.js</span>
    </div>

  </div>
</div>

<script>
function showSignupAlert(message, type) {
  const alert = document.getElementById('signupAlert');
  const icons = { error: '❌', success: '✅', warning: '⚠️', info: 'ℹ️' };
  alert.className = `alert alert-${type}`;
  alert.innerHTML = `<span class="alert-icon">${icons[type]}</span><span></span>`;
  alert.querySelector('span:last-child').textContent = message;
  alert.style.display = 'flex';
}

function toggleSignupPassword() {
  const inputs = [document.getElementById('signupPassword'), document.getElementById('signupPassword2')];
  const show = inputs[0].type === 'password';
  inputs.forEach(i => { i.type = show ? 'text' : 'password'; });
  document.getElementById('pwToggle').textContent = show ? '🙈' : '👁️';
}

async function handleSignup(e) {
  e.preventDefault();
  const username = document.getElementById('signupUsername').value.trim();
  const email = document.getElementById('signupEmail').value.trim();
  const password = document.getElementById('signupPassword').value;
  const password2 = document.getElementById('signupPassword2').value;
  const btn = document.getElementById('signupBtn');

  if (!/^[a-zA-Z0-9_.-]{3,32}$/.test(username)) {
    return showSignupAlert('Username must be 3–32 characters: letters, numbers, _ . - only.', 'error');
  }
  if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    return showSignupAlert('Please enter a valid email address or leave it empty.', 'error');
  }
  if (password.length < 6) {
    return showSignupAlert('Password must be at least 6 characters.', 'error');
  }
  if (password !== password2) {
    return showSignupAlert('Passwords do not match.', 'error');
  }

  btn.disabled = true;
  btn.textContent = 'Creating account...';
  try {
    const res = await fetch('/api/auth/signup', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username, email, password })
    });
    const data = await res.json().catch(() => ({}));
    if (res.ok && data.success) {
      btn.textContent = '✅ Account created! Redirecting...';
      window.location.href = data.redirect || '/dashboard';
      return;
    }
    showSignupAlert(data.error || 'Sign-up failed. Please try again.', 'error');
  } catch (err) {
    showSignupAlert('Network error. Please try again.', 'error');
  }
  btn.disabled = false;
  btn.textContent = 'Create Account';
}

async function loadDiscordSettings() {
  try {
    const res = await fetch('/api/discord-enabled');
    if (!res.ok) return;
    const settings = await res.json();
    if (settings.enabled) {
      const discordBtn = document.getElementById('discordLoginBtn');
      if (discordBtn) {
        discordBtn.style.display = 'flex';
        discordBtn.style.alignItems = 'center';
        discordBtn.style.justifyContent = 'center';
        discordBtn.style.gap = '8px';
      }
    }
  } catch (err) {
    console.error('Failed to load Discord settings:', err);
  }
}

async function loginWithDiscord() {
  const btn = document.getElementById('discordLoginBtn');
  try {
    btn.disabled = true;
    btn.style.opacity = '0.6';
    const res = await fetch('/api/discord-auth-url');
    if (!res.ok) throw new Error('Failed to get Discord auth URL');
    const data = await res.json();
    window.location.href = data.url;
  } catch (err) {
    showSignupAlert('Discord sign-up is not set up yet. Please contact the administrator.', 'error');
    btn.disabled = false;
    btn.style.opacity = '1';
    console.error('Discord signup error:', err);
  }
}

document.addEventListener('DOMContentLoaded', loadDiscordSettings);
</script>
</body>
</html>
